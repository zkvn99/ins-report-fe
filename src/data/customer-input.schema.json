{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:health-asset:input:2.0",
  "title": "건강자산 간소화 입력 2.0",
  "description": "AI는 원문 사실만 추출한다. ID 생성·합산·부족금액·통계선택·페이지 구성은 Vue 애플리케이션이 담당한다.",
  "type": "object",
  "required": [
    "version",
    "customer",
    "health",
    "insurance"
  ],
  "properties": {
    "version": {
      "const": "2.0"
    },
    "report_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}[-.]\\d{2}[-.]\\d{2}$"
    },
    "customer": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "birth_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}[-.]\\d{2}[-.]\\d{2}$"
        },
        "age": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 120
        },
        "sex": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "health": {
      "type": "object",
      "required": [
        "metrics"
      ],
      "additionalProperties": true,
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "provider": {
              "type": [
                "string",
                "null"
              ]
            },
            "checkup_date": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^\\d{4}[-.]\\d{2}[-.]\\d{2}$"
            },
            "institution": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "value",
              "state"
            ],
            "additionalProperties": true,
            "properties": {
              "id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": "string"
              },
              "short_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "value": {
                "type": [
                  "number",
                  "string",
                  "null"
                ]
              },
              "unit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reference": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "comment": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "state": {
                "enum": [
                  "good",
                  "watch",
                  "action",
                  "unknown",
                  "info"
                ]
              },
              "areas": {
                "type": "array",
                "items": {
                  "enum": [
                    "brain",
                    "oral",
                    "lung",
                    "pressure",
                    "liver",
                    "glucose",
                    "kidney",
                    "lipid",
                    "stomach",
                    "weight"
                  ]
                },
                "uniqueItems": true
              },
              "featured": {
                "type": "boolean"
              },
              "source_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "visual": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "numeric": {
                    "type": "number"
                  },
                  "ref_low": {
                    "type": "number"
                  },
                  "ref_high": {
                    "type": "number"
                  }
                }
              },
              "metric_key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "record_key": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "area_notes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "area",
              "state"
            ],
            "additionalProperties": true,
            "properties": {
              "area": {
                "enum": [
                  "brain",
                  "oral",
                  "lung",
                  "pressure",
                  "liver",
                  "glucose",
                  "kidney",
                  "lipid",
                  "stomach",
                  "weight"
                ]
              },
              "state": {
                "enum": [
                  "good",
                  "watch",
                  "action",
                  "unknown",
                  "info"
                ]
              },
              "detail": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "record_key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "provider": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "checkup_date": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^\\d{4}[-.]\\d{2}[-.]\\d{2}$"
              },
              "institution": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_ref": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "insurance": {
      "type": "object",
      "required": [
        "coverages"
      ],
      "additionalProperties": true,
      "properties": {
        "source_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "as_of_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}[-.]\\d{2}[-.]\\d{2}$"
        },
        "source_complete": {
          "type": "boolean"
        },
        "coverages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "company",
              "product",
              "rider_name",
              "amount_won"
            ],
            "additionalProperties": true,
            "properties": {
              "company": {
                "type": "string"
              },
              "product": {
                "type": "string"
              },
              "rider_name": {
                "type": "string"
              },
              "amount_won": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "coverage_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "insured": {
                "enum": [
                  "self",
                  "other",
                  "unknown"
                ]
              },
              "source_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_rider_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_entry_key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "policy_key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_group": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "amount_basis": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "payment_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mapping_status": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "aggregation_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "benefit_pool_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "provider_type": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "standards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "coverage_id",
          "amount_won"
        ],
        "additionalProperties": false,
        "properties": {
          "coverage_id": {
            "type": "string"
          },
          "amount_won": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "message"
        ],
        "additionalProperties": true,
        "properties": {
          "severity": {
            "enum": [
              "blocking",
              "warning",
              "info"
            ]
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": true
}